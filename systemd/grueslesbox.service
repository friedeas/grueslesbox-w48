[Unit]
Description=Grueslesbox W48 Audio Guestbook Controller
After=network.target sound.target

[Service]
Type=simple
# Run the service under your specific username and group
User=friedeas
Group=friedeas

# Absolute path to your project directory
WorkingDirectory=/home/friedeas/grueslesbox-w48

# Execute directly from the project's virtual environment
ExecStart=/home/friedeas/grueslesbox-w48/.venv/bin/start_grueslesbox

# Automatically restart the service if it crashes
Restart=on-failure
RestartSec=5

# Direct output and errors to the systemd journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target